import java.util.HashMap;
import java.util.Map;

// Represents a classroom
class Classroom {
    private String classroomId;
    private String roomName;
    private String equipment;

    public Classroom(String classroomId, String roomName,
                     String equipment) {
        this.classroomId = classroomId;
        this.roomName = roomName;
        this.equipment = equipment;
    }

    public void getDetails() {
        System.out.println("ID: " + classroomId);
        System.out.println("Room: " + roomName);
        System.out.println("Equipment: " + equipment);
    }
}

// Registry for managing classroom objects
class ClassroomRegistry {

    private final Map<String, Classroom> classrooms =
            new HashMap<>();

    public void register(String id, Classroom classroom) {
        if (classrooms.containsKey(id)) {
            throw new IllegalArgumentException(
                    "Classroom ID already registered: " + id);
        }

        classrooms.put(id, classroom);
        System.out.println(id + " registered");
    }

    public Classroom getClassroom(String id) {
        return classrooms.get(id);
    }

    public void remove(String id) {
        classrooms.remove(id);
        System.out.println(id + " removed");
    }
}

// Demonstrates the Registry Pattern
public class Main {
    public static void main(String[] args) {

        ClassroomRegistry registry =
                new ClassroomRegistry();

        // Create classroom objects
        Classroom c1 = new Classroom(
                "C101", "Seminar Hall", "Projector");

        Classroom c2 = new Classroom(
                "C102", "Computer Lab", "Smart Board");

        Classroom c3 = new Classroom(
                "C103", "Conference Room", "Speaker");

        // Register classrooms
        registry.register("C101", c1);
        registry.register("C102", c2);
        registry.register("C103", c3);

        // Retrieve and display a classroom
        System.out.println("\nRetrieved classroom:");

        Classroom room = registry.getClassroom("C102");

        if (room != null) {
            room.getDetails();
        } else {
            System.out.println("Classroom not found");
        }

        // Remove a classroom
        System.out.println("\nRemoving classroom:");
        registry.remove("C101");

        // Try retrieving the removed entry
        System.out.println("\nSearching for C101:");

        Classroom removedRoom =
                registry.getClassroom("C101");

        if (removedRoom == null) {
            System.out.println("Classroom not found");
        } else {
            removedRoom.getDetails();
        }
    }
}
